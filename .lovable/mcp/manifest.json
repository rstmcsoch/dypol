          "properties": {
            "subject": {
              "description": "Subject to filter by, e.g. Physics.",
              "type": "string",
              "maxLength": 60
            },
            "search": {
              "description": "Text to search for in titles.",
              "type": "string",
              "maxLength": 100
            },
            "limit": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
